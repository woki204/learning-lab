// ⚠️ אל תדביק את הקובץ הזה כמו שהוא במקום הכללים הקיימים.
//
// פרויקט Firestore אחד (eduai-planner-1b6ac) משרת גם את אתר הפורטפוליו,
// שמשתמש בקולקציות users / apps / clicks / favCounts. החלפת כל הכללים
// בקובץ הזה תנתק את הפורטפוליו מהנתונים שלו.
//
// מה לעשות: פתח Firebase Console → Firestore → Rules, ושתול את שלושת
// הבלוקים שלמטה *בתוך* הכללים הקיימים, ממש לפני הסוגר המסולסל האחרון
// של `match /databases/{database}/documents { ... }`.
//
// כל מה ששייך למעבדת הלמידה נושא תחילית ll_ ולכן אינו מתנגש בשום דבר קיים.

// ── 1. פונקציות עזר ──────────────────────────────────────────

function llSignedIn() {
  return request.auth != null;
}

function llIsAdmin() {
  return llSignedIn()
    && exists(/databases/$(database)/documents/ll_users/$(request.auth.uid))
    && get(/databases/$(database)/documents/ll_users/$(request.auth.uid)).data.role == 'admin';
}

// ── 2. נעילת ההקמה + פרופילי המרצים והמנהלים ─────────────────

match /ll_meta/{docId} {
  allow read: if true;
  // ניתן ליצור פעם אחת בלבד — קיום המסמך נועל את עמוד ההקמה לתמיד.
  allow create: if llSignedIn()
    && !exists(/databases/$(database)/documents/ll_meta/bootstrap);
  allow update, delete: if false;
}

match /ll_users/{uid} {
  allow read: if llSignedIn() && (request.auth.uid == uid || llIsAdmin());
  allow delete: if llIsAdmin();

  // יצירה: על ידי מנהל, או — פעם אחת, לפני שהנעילה נכתבה —
  // על ידי המשתמש הראשון שמקים את עצמו כמנהל דרך עמוד /setup.
  allow create: if llIsAdmin()
    || (llSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/ll_meta/bootstrap));
  allow update: if llIsAdmin()
    || (request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['mustChangePassword', 'passwordChangedAt', 'displayName']));
}

// ── 3. מאגר התמונות ──────────────────────────────────────────
// קריאה ציבורית, כי לומדים רואים תמונות בלי חשבון.
// כתיבה ומחיקה — רק הבעלים.

match /ll_media/{mediaId} {
  allow read: if true;
  allow create: if llSignedIn() && request.resource.data.ownerUid == request.auth.uid;
  allow update, delete: if llSignedIn()
    && (resource.data.ownerUid == request.auth.uid || llIsAdmin());
}

// ── 4. סביבות הלמידה ─────────────────────────────────────────
// קריאה ציבורית רק אחרי פרסום — זה מה שמאפשר ללומדים להיכנס
// דרך הקישור בלי חשבון. כתיבה — לבעלים או למנהל בלבד.

match /ll_courses/{courseId} {
  allow read: if resource.data.published == true
    || (llSignedIn() && (resource.data.ownerUid == request.auth.uid || llIsAdmin()));

  allow create: if llSignedIn()
    && request.resource.data.ownerUid == request.auth.uid;

  allow update, delete: if llSignedIn()
    && (resource.data.ownerUid == request.auth.uid || llIsAdmin());
}
